--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--SetEncoderNames
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function SetEncoderNames(raw)
  local input = raw
  local tab = {}
  --local index = nil
  --local decoder = nil
   -- print ("raw "..raw)

-- [^,%s]+ matches any character sequence that is NOT a comma or whitespace
  for results in string.gmatch(input, "[^,%s]+") do
   -- print ("results "..results..", ")
    table.insert(tab, results)
  end

  local index = tonumber(tab[1])
  Encoder_Name_Table[index] = tab[2]

  if index == #Encoder_Id_Table then

    for i = 1, #Encoder_Id_Table do
      if tonumber(Controls.SelectEncCecCmdId.String) == i then
        Controls.EncCecCmdName.String = Encoder_Name_Table[i]
      break
      end
    end

    for i = 1, #Encoder_Id_Table do
      if tonumber(Controls.SelectEncRs232Id.String) == i then
        Controls.EncRs232CmdName.String = Encoder_Name_Table[i]
      break
      end
    end

    for i = 1, #Encoder_Id_Table do
      if tonumber(Controls.SelectEncAudInputId.String) == i then
        Controls.EncAudInputName.String = Encoder_Name_Table[i]
      break
      end
    end

    for i = 1, #Encoder_Id_Table do
      if tonumber(Controls.SelectEncSwitchId.String) == i or Controls.SelectEncSwitchId.String == "None"  then
        if Controls.SelectEncSwitchId.String == "None" then
          Controls.EncSwitchName.String = "None"
        else
          Controls.EncSwitchName.String = Encoder_Name_Table[i]
        end
      break
      end 
    end
  end

end

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--SetDecoderNames
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function SetDecoderNames(raw)
  local input = raw
  local tab = {}
  --local index = nil
  --local decoder = nil

-- [^,%s]+ matches any character sequence that is NOT a comma or whitespace
  for results in string.gmatch(input, "[^,%s]+") do
    table.insert(tab, results)
  end

  local index = tonumber(tab[1])
  Decoder_Name_Table[index] = tab[2]

  --print("Decoder_Name_Table: "..tostring(index).." "..Decoder_Name_Table[index])

  if index == #Decoder_Id_Table then

    for i = 1, #Decoder_Id_Table do
      if tonumber(Controls.SelectDecSwitchId.String) == i then
        Controls.DecSwitchName.String = Decoder_Name_Table[i]
      break
      end
    end

    for i = 1, #Decoder_Id_Table do
      if tonumber(Controls.SelectDecCmdId.String) == i then
        Controls.DecCmdName.String = Decoder_Name_Table[i]
      break
      end
    end

    for i = 1, #Decoder_Id_Table do
      if tonumber(Controls.SelectDecRs232CmdId.String) == i then
        Controls.DecRs232CmdName.String = Decoder_Name_Table[i]
      break
      end
    end
  end

end

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--SetDecoderStatus
--             ID, v,a,s,r,u,c
--<List decoder 1 1,1,0,0,0,0
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

function SetDecoderStatus(raw)
  local input = raw
  local tab = {}
  --local index = nil
  --local decoder = nil

  -- print("List decoder: "..raw)


-- [^,%s]+ matches any character sequence that is NOT a comma or whitespace
  for results in string.gmatch(input, "[^,%s]+") do
    table.insert(tab, results)
  end

  local index = tonumber(tab[1])

  Decoder_Status_Table[index].TypeVid   = tab[2]
  Decoder_Status_Table[index].TypeAud   = tab[3]
  Decoder_Status_Table[index].TypeRS232 = tab[4]
  Decoder_Status_Table[index].TypeIR    = tab[5]
  Decoder_Status_Table[index].TypeUsb   = tab[6]
  Decoder_Status_Table[index].TypeCec   = tab[7]
  --print("Decoder_Status_Table: "..Decoder_Status_Table[index].TypeVid..", "..Decoder_Status_Table[index].TypeAud..", "
 -- ..Decoder_Status_Table[index].TypeRS232..", "..Decoder_Status_Table[index].TypeIR..", "..Decoder_Status_Table[index].TypeUsb..", "..Decoder_Status_Table[index].TypeCec)

  if Controls["SelectDecSwitchId"].String == tab[1] then
    ShowRoute (index, "ShowDecRoute")
  end

  for i = 1, #SelectDecVidId do
--print ("SelectDecVidId: "..Controls[SelectDecVidId[i].Dec].String) 
    if Controls[SelectDecVidId[i].Dec].String ~= "None" and SelectDecVidId[i].Num == index then
      ShowVidRoute (index, SelectDecVidId[i].Name, i)
      break
    end
  end
  for i = 1, #SelectDecAudId do
    if Controls[SelectDecAudId[i].Dec].String ~= "None" and SelectDecAudId[i].Num == index then
      ShowAudRoute (index, SelectDecAudId[i].Name, i)
      break
    end
  end
end

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--GetRxData
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function GetRxData(RxData)
  print("Received data: "..RxData)

  if string.find(RxData, "ListEncoderNames", 1, true) then
  --  print("ListEncoderNames: "..RxData)
    SetEncoderNames(RxData:gsub("<ListEncoderNames ",""))
  elseif string.find(RxData, "ListDecoderNames", 1, true) then
    --print("ListDecoderNames: "..RxData)
    SetDecoderNames(RxData:gsub("<ListDecoderNames ",""))
  elseif string.find(RxData, "List decoder", 1, true) then
    SetDecoderStatus(RxData:gsub("<List decoder ",""))
  end

end


--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--GetDevNames
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function GetDevNames()
  TxQue:Push("ListEncoderNames")
  TxQue:Push("ListDecoderNames")
end

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--GetStatus
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function GetStatus()
  for i = 1, #Decoder_Id_Table do
    TxQue:Push("ListDecoder "..tostring(i))
  end
end

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--GetStatus
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function GetStatusDelay(Time)
  Timer.CallAfter(function()
--          print("This message prints after 2.0 seconds.")
    GetStatus()
  end, Time)
  
--[[
  local RxData = "<ListDecoderNames 1,LG-TV,169.254.0.111"
  SetDecoderNames(RxData:gsub("<ListDecoderNames ", ""))

  local RxData = ">List decoder 1 1,1,0,0,0,0"
  SetDecoderStatus(RxData:gsub(">List decoder ", ""))
  
  local RxData = ">List decoder 2 1,1,0,0,0,1"
  SetDecoderStatus(RxData:gsub(">List decoder ", ""))
]]
  
end

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--TcpClientInitHandle
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

function TcpClientInitHandle()
  local Tcpip   = Properties["IP"].Value                     
  local TcpPort = Properties["TcpPort"].Value

  port = tonumber(TcpPort) or 4001

  NET.TcpClient = TcpSocket.New()
  NET.TcpClient.EventHandler = function(sock, evt, err) -- Requires an end
    -- TCP
    if evt == TcpSocket.Events.Connected then
      print( "Socket Connected" )
      Controls.NetControllerConnect.Value = 1       --
      Controls.NetControllerStatus.Color = "green"  --
      NET.Connected = 1;
      NET.TcpClient:Write("tcp client connect success...")  --
      TxQue:Clear()
      GetDevNames()
      GetStatusDelay("2.0")
    -- TCP 
    elseif evt == TcpSocket.Events.Reconnect then
      NET.Connected = 0;
      print( "socket reconnecting..." )
    -- TCP 
    elseif evt == TcpSocket.Events.Data then      
      NET.Connected = 1;
      message = NET.TcpClient:ReadLine(TcpSocket.EOL.Any)
      while (message ~= nil) do
        message = message:gsub("[\r\n]+$", "") 
        --[[+: Looks for one or more consecutive newline/carriage return characters. 
                $: Anchors the match strictly to the end of the string.]]
        if message ~= nil then
          GetRxData(message)
          --print( "Info:"..message )
        end
        message = sock:ReadLine(TcpSocket.EOL.Any) --
      end  
    --TCP
    elseif evt == TcpSocket.Events.Closed then
      NET.Connected = 0;
      print( "socket closed by remote" )
    -- TCP
    elseif evt == TcpSocket.Events.Error then
      NET.Connected = 0;
      print( "socket closed due to error", err )
    --TCP
    elseif evt == TcpSocket.Events.Timeout then
      NET.Connected = 0;
      print( "socket closed due to timeout" )
    else
      NET.Connected = 0;
      print( "unknown socket event", evt ) --should never happen
    end

    if NET.Connected == 0 then
        TxQue:Clear()
    end
  end
  Controls["NetControllerConnect"].Value = NET.Connected
  NET.TcpClient:Connect(Tcpip, port)
end

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--SerialInitHandle
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function SerialInitHandle()
  --
  local SerialName     = Properties["SerialName"].Value  
  local SerialBaudRate = Properties["baudrate"].Value     
  local SerilDataBit   = Properties["datalen"].Value     
  local SerilParity    = Properties["paritybit"].Value    

  SerialBaudRate = tonumber(SerialBaudRate) or 9600
  SerilDataBit   = tonumber(SerilDataBit) or 8

  -- .SerialPorts
  serialName = SerialPorts[SerialName]
  if serialName == nil then
    print("The system cannot find the Serial Port.")
    return
  end
  -- 
  serialName.EventHandler = function( port, msg) -- Requires an end

    if msg == SerialPorts.Events.Data then
      local line = port:ReadLine(SerialPorts.EOL.Any) -- Detects \r or \n
      while line ~= nil do
        --print( "read line", line)
        --line = port:ReadLine(SerialPorts.EOL.Any)
        if line ~= nil then 
          GetRxData(line)
        end
        line = port:ReadLine(SerialPorts.EOL.Any)
      end
    end
  end
  
  local sendControl = Controls.Inputs["serialNume"]
  if not sendControl then
    print("The system cannot find the Send Serial.")
  else        
    Controls.Inputs["serialNume"].EventHandler = function() -- Requires an end
      if not serialNume.IsOpen then
        serialNume:Open(SerialBaudRate, SerilDataBit, SerilParity)
        TxQue:Clear()
        GetDevNames()
        GetStatusDelay("2.0")
      end
    end
  end
end

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--ControllerNetworkConnectEvent
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function ControllerNetworkConnectEvent(ctrl, Cmd, ComponentsName, EncodreId, CmdId)
  local isOn = nil

   --print("ControllerNetworkConnectEvent Cmd: "..Cmd)

  isOn = ctrl.Value
  if Cmd == "Connect" then
    print("NetControllerConnect:"..isOn)

    local CommMode = Properties["Connection"].Value
    if CommMode ~= "TCP" then
      print("Not in TCP mode, cannot connect.")
      return
    end

    if isOn == 1 then
      TcpClientInitHandle()     --TCP Client
    elseif isOn == 0 then
      if NET.TcpClient and NET.TcpClient.IsConnected then
        NET.TcpClient:Disconnect()
        print("Disconnecting TCP")
        Controls.NetControllerStatus.Color = "red"
        NET.Connected = 0;
      end
    end
  elseif Cmd == "SendPresetCmd" then
    local Index
    for Index = 1, #Preset_Table do
      if Controls[EncodreId].String == Preset_Table[Index] then
        TxQue:Push("Recall "..tostring(Index))
        GetStatusDelay("6.0")
        break
      end
    end
  elseif Cmd == "SendApiCmd" then
--        print("SendApiCmd "..Controls.SetApiCmd.String)
    TxQue:Push(Controls.SetApiCmd.String)
  elseif Cmd == "GetStatus" then
    GetStatus()
  end
end

EncoderAudAnalog = {}

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--EncoderControlEvent
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function EncoderControlEvent(ctrl, Cmd, ComponentsName, EncodreId, CmdId)

--  local isPressed = nil
  local EncId = nil
  local Index

    --print("EncoderControlEvent Cmd: "..Cmd.." ComponentsName: "..ComponentsName.." EncodreId: "..EncodreId)
  --+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  --Audio Input Setting
  --isPressed = ctrl.Value
  if Cmd == "Audio" then
--    print("EncodreId: "..EncodreId.." ComponentsNameComponentsName: "..ComponentsName)
    Index = tonumber(Controls[EncodreId].String)
    if ComponentsName == "SetEncAudInputHdmi" then
--      print("SetEncAudInputHdmi isPressed")
      Controls["SetAudInputAnalog"].Value  = 0
      Controls["SetEncAudInputHdmi"].Value = 1
      EncoderAudAnalog[Index] = 0
    elseif ComponentsName == "SetAudInputAnalog" then
--      print("SetAudI-nputAnalog isPressed")
      Controls["SetAudInputAnalog"].Value  = 1
      Controls["SetEncAudInputHdmi"].Value = 0
      EncoderAudAnalog[Index] = 1
    end
      TxQue:Push("EmbAudE "..Controls[EncodreId].String.." "..EncoderAudAnalog[Index])
  elseif Cmd == "Cmds" then
    for Index = 1, #Encoder_Id_Table do
      if Controls[EncodreId].String == Encoder_Id_Table[Index] then
        EncId = tostring(Index)
        break
      end
    end
    for Index = 1, #Encoder_Cec_Table do
      if Controls[CmdId].String == Encoder_Cec_Table[Index].Name then
        TxQue:Push("CECE "..EncId.." "..Encoder_Cec_Table[Index].Cmd)
        break
      end
    end
  elseif Cmd == "RS232" then
    local RS232Cfg = "RS232Cfg"  
    for Index = 1, #Encoder_Id_Table do
      if Controls[EncodreId].String == Encoder_Id_Table[Index] then
        EncId = tostring(Index)
        TxQue:Push("RS232E "..EncId.." "..Controls.SetEncRs232Cfg.String.." "..Controls[CmdId].String)
        break
      end
    end                       --  EncoderControlEvent(ctrl, Cmd,     ComponentsName,       EncodreId,       CmdId)
  elseif Cmd == "Name" then  -- EncoderControlEvent(ctrl, "Name", "SelectEncCecCmdId",   "EncCecCmdName",   nil) 
    --print("EncoderControlEvent Name: "..Controls[ComponentsName].String)
    Index = tonumber(Controls[ComponentsName].String)
    if Index > 0 then 
      Controls[EncodreId].String = Encoder_Name_Table[Index]
    end
--    print("EncodreId: "..EncodreId.." Index: "..tostring(Index))
    if EncodreId == "EncAudInputName" then
      if (EncoderAudAnalog[Index] == 1) then
        Controls["SetAudInputAnalog"].Value  = 1
        Controls["SetEncAudInputHdmi"].Value = 0
      else
        Controls["SetAudInputAnalog"].Value  = 0
        Controls["SetEncAudInputHdmi"].Value = 1
      end
    end 
  end
end --

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--DecoderControlEvent
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function DecoderControlEvent(ctrl, Cmd, ComponentsName, EncoderId, DecoderId, CmdId)
  local isPressed = 0
  local EncId     = 0
  local EncIdx    = 0
  local DecId     = 0
  local DecIdx    = 0
  local Type      = 0
  local Index     = 0
  if Cmd == "Switch" then
    for Index = 1, #Encoder_Sw_Id_Table do
      if Controls[EncoderId].String == Encoder_Sw_Id_Table[Index] then
        if Index == 1 then
          EncId = "None"
        else
          EncId = tostring(Index-1)
        end
          EncIdx = Index-1
        break
      end
    end

    for Index = 1, #Decoder_Id_Table do
      if Controls[DecoderId].String == Decoder_Id_Table[Index] then
        DecId = tostring(Index)
        DecIdx = Index
        break
      end
    end
    for Index = 1, #Decoder_Type_Table do
      if Controls[CmdId].String == Decoder_Type_Table[Index].Name then
        Type = Decoder_Type_Table[Index].Cmd
        break
      end
    end

    if Type == "all" then
    --print ("Switch EncIndx: "..tostring(EncIdx).." DecIdx: "..tostring(DecIdx).." Type: "..Type) 
      Decoder_Status_Table[DecIdx].TypeVid   = EncIdx
      Decoder_Status_Table[DecIdx].TypeAud   = EncIdx
      Decoder_Status_Table[DecIdx].TypeRS232 = EncIdx
      Decoder_Status_Table[DecIdx].TypeIR    = EncIdx
      Decoder_Status_Table[DecIdx].TypeUsb   = EncIdx
      Decoder_Status_Table[DecIdx].TypeUsb   = EncIdx
      Decoder_Status_Table[DecIdx].TypeCec   = EncIdx
    elseif Type == "v" then
      Decoder_Status_Table[DecIdx].TypeVid   = EncIdx
    elseif Type == "a" then
      Decoder_Status_Table[DecIdx].TypeAud   = EncIdx
    elseif Type == "s" then
      Decoder_Status_Table[DecIdx].TypeRS232 = EncIdx
    elseif Type == "r" then
      Decoder_Status_Table[DecIdx].TypeIR    = EncIdx
    elseif Type == "u" then
      Decoder_Status_Table[DecIdx].TypeUsb   = EncIdx
    elseif Type == "c" then
      Decoder_Status_Table[DecIdx].TypeCec   = EncIdx
    end
    if Type == "all" then
      TxQue:Push("Switch "..EncId.." "..Type)
    else
      TxQue:Push("Switch "..EncId.." "..DecId.." "..Type)
    end
    ShowRoute (DecIdx, "ShowDecRoute")
    if Type == "all" or Type == "v" then
      for i = 1, #SelectDecVidId do
    --print ("SelectDecVidId: "..Controls[SelectDecVidId[i].Dec].String) 
        if Controls[SelectDecVidId[i].Dec].String ~= "None" and SelectDecVidId[i].Num == DecIdx then
          ShowVidRoute (DecIdx, SelectDecVidId[i].Name, i)
          break
        end
      end
    end
    if Type == "all" or Type == "a" then
      for i = 1, #SelectDecAudId do
        if Controls[SelectDecAudId[i].Dec].String ~= "None" and SelectDecAudId[i].Num == DecIdx then
          ShowAudRoute (DecIdx, SelectDecAudId[i].Name, i)
          break
        end
      end
    end
    --(ctrl, Cmd,   ComponentsName, EncoderId, DecoderId,           CmdId)
    --(ctrl, "Cmds", "SendDecCmd",     nil,    "SelectDecCmdId", "SelectDecCmd"
  elseif Cmd == "Cmds" then
    if ComponentsName == "SendDecCmd" then
      for Index = 1, #Decoder_Id_Table do
        if Controls[DecoderId].String == Decoder_Id_Table[Index] then
          DecId = tostring(Index)
          break
        end
      end
      for Index = 1, #Decoder_Cmd_Table do
        --print("DecId "..DecId.." Cmd: "..Controls[DecoderId].String.." Table Name: "..Decoder_Cmd_Table[Index].Name)
        if Controls[CmdId].String == Decoder_Cmd_Table[Index].Name then
          if Decoder_Cmd_Table[Index].Value == "0" then
            TxQue:Push(Decoder_Cmd_Table[Index].Cmd.." "..DecId)
          else
            TxQue:Push(Decoder_Cmd_Table[Index].Cmd.." "..DecId.." "..Decoder_Cmd_Table[Index].Value)
          end
          break
        end
      end
    end
    --(ctrl, Cmd,     ComponentsName, EncoderId, DecoderId,           CmdId)
    --ctrl, "RS232", "SendDecRs232Cmd",  nil,  "SelectDecRs232CmdId", "SetDecRs232Cmd"
  elseif Cmd == "RS232" then  
    local RS232Cfg = "RS232Cfg"  
    for Index = 1, #Decoder_Id_Table do
      if Controls[DecoderId].String == Decoder_Id_Table[Index] then
        DecId = tostring(Index)
        TxQue:Push("RS232D "..DecId.." "..Controls.SetDecRs232Cfg.String.." "..Controls[CmdId].String)
        break
      end
    end
    --(ctrl, Cmd,     ComponentsName,      EncoderId, DecoderId,  CmdId)
    --ctrl, "VidWall", "SendDecVidWallOn",  nil,       nil, "VidWallName")  end
  elseif Cmd == "VidWall" then 
    if ComponentsName == "SendDecVidWallOn" then
      Controls.SendDecVidWallOn.Boolean  = true
      Controls.SendDecVidWallOff.Boolean = false
      TxQue:Push(">VideoWall <"..Controls[CmdId].String..">".." 1")
    else
      Controls.SendDecVidWallOn.Boolean  = false
      Controls.SendDecVidWallOff.Boolean = true
      TxQue:Push("VideoWall <"..Controls[CmdId].String..">".." 0")
    end
  elseif Cmd == "Name" then  
    if Controls[ComponentsName].String == "None" then
        Controls[EncoderId].String = "None"
    else
      Index = tonumber(Controls[ComponentsName].String)
   --print("DecoderControlEvent Name: "..Controls[ComponentsName].String.." DecoderId "..DecoderId[Index])
      Controls[EncoderId].String = DecoderId[Index]
    end
    --(ctrl, Cmd,     ComponentsName,      EncoderId,         DecoderId,           CmdId)
    --ctrl, "Show", "SelectDecSwitchId",   "DecSwitchName",   Decoder_Name_Table, "ShowDecRoute"
  elseif Cmd == "Show" then  
    Index = tonumber(Controls[ComponentsName].String)
    Controls[EncoderId].String = DecoderId[Index]
    ShowRoute (Index, CmdId)

    --(ctrl, Cmd,     ComponentsName,      EncoderId,                 DecoderId,       CmdId)
    --ctrl, "ShowVid", "SelectDecVidId_"..i, "SelectDecVidName_"..i, Decoder_Name_Table, i)
  elseif Cmd == "ShowVid" then  
    Index = tonumber(Controls[ComponentsName].String)
    SelectDecVidId[CmdId].Num = Index
    ShowVidRoute (Index, EncoderId, CmdId)
  elseif Cmd == "ShowAud" then  
    Index = tonumber(Controls[ComponentsName].String)
    SelectDecAudId[CmdId].Num = Index
    ShowAudRoute (Index, EncoderId, CmdId)
  end 

end

function FindInTable(t, targetValue)
  for index, value in ipairs(t) do
    if value == targetValue then
        return index
    end
  end
  return nil
end

------------------------------- Runtime Logic ---------------------------------

if Controls then
------------------------------------ Objects ----------------------------------


-------------------------------- Initialization -------------------------------
-- 
  function initControls()
    --[[
    for name, control in pairs(Controls) do
        print("Component: " .. name)
    end
    ]]
    local CommMode = Properties["Connection"].Value
    if CommMode == "TCP" then    
      TcpClientInitHandle()
    elseif CommMode == "RS232"  then
      SerialInitHandle()
    end
    local Presetsize  = Properties["Preset_Size"].Value
    Presetsize = tonumber(Presetsize) or 8
    local Encodersize = Properties["Encoder_Size"].Value
    local Decodersize = Properties["Decoder_Size"].Value
    Encodersize = tonumber(Encodersize) or 4
    local EncodersizeSw = Encodersize + 1
    Decodersize = tonumber(Decodersize) or 8
    local EnoderCecCmds = {}
    local DecoderType = {}
    local DecoderCmds = {}


  --+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  --TxQueTimerEvent
  --+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    TxQueTimer = Timer.New()

    TxQueTimer.EventHandler = function()
      -- Implementation for timer event

      local sendData = TxQue:Pop()
      if sendData ~= nil then
        SendData_ToDevices(sendData)
      else
        TxQueTimer:Stop()
      end
    end


    for i = 1, Presetsize do
      Preset_Table[i] = tostring(i)
    end

    for i = 1, #Encoder_Cec_Table do
      EnoderCecCmds[i] = Encoder_Cec_Table[i]["Name"]
    end

    for i = 1, EncodersizeSw do
      if i == 1 then
        Encoder_Sw_Id_Table[i] = "None"
      else
        Encoder_Sw_Id_Table[i] = tostring(i-1)
      end 
    end

    for i = 1, Encodersize do
      Encoder_Id_Table[i] = tostring(i)
    end

    for i = 1, Decodersize do
      Decoder_Id_Table[i] = tostring(i)
    end

    for i = 1, #Decoder_Type_Table do
      DecoderType[i] = Decoder_Type_Table[i]["Name"]
    end

    for i = 1, #Decoder_Cmd_Table do
      DecoderCmds[i] = Decoder_Cmd_Table[i]["Name"]
    end

    for i = 1, Decodersize do
      table.insert(Decoder_Status_Table, {TypeVid = 0, TypeAud = 0, TypeRS232 = 0, TypeIR = 0, TypeUsb = 0, TypeCec = 0})
    end

    for i = 1, Encodersize do
      Encoder_Name_Table[i] = "Encoder "..tostring(i)
    end

    for i = 1, Decodersize do
      Decoder_Name_Table[i] = "Decoder "..tostring(i)
    end

    for i = 1, Encodersize do
      EncoderAudAnalog[i] = 0
    end

    if #Controls.SetEncRs232Cfg.String == 0 then
      Controls.SetEncRs232Cfg.String = "9600-8n1"
    end
    
    if #Controls.SetDecRs232Cfg.String == 0 then
      Controls.SetDecRs232Cfg.String = "9600-8n1"
    end
    
    if #Controls.VidWallName.String == 0 then
      Controls.VidWallName.String = "Video Wall 1"
    end

    Controls.NetControllerConnect.Value = 0 

    if Controls.SendDecVidWallOn.Boolean == false and Controls.SendDecVidWallOff.Boolean == false then
      Controls.SendDecVidWallOn.Boolean  = true
      Controls.SendDecVidWallOff.Boolean = false
    end

    Controls["SelectPresetId"].Choices = Preset_Table
    Controls["SelectPresetId"].String  = Preset_Table[1]

  --Encoder
    Controls["SelectEncCecCmdId"].Choices = Encoder_Id_Table
    Controls["SelectEncCecCmdId"].String  = Encoder_Id_Table[1]

    Controls["SelectEncCecCmd"].Choices = EnoderCecCmds
    Controls["SelectEncCecCmd"].String  = EnoderCecCmds[1]

    Controls["SelectEncRs232Id"].Choices = Encoder_Id_Table
    Controls["SelectEncRs232Id"].String  = Encoder_Id_Table[1]

    Controls["SelectEncAudInputId"].Choices = Encoder_Id_Table
    Controls["SelectEncAudInputId"].String  = Encoder_Id_Table[1]

    --Decoder    
    Controls["SelectEncSwitchId"].Choices = Encoder_Sw_Id_Table
    Controls["SelectEncSwitchId"].String  = Encoder_Sw_Id_Table[1]

    Controls["SelectDecSwitchId"].Choices = Decoder_Id_Table
    Controls["SelectDecSwitchId"].String  = Decoder_Id_Table[1]

    Controls["SelectSwitchType"].Choices = DecoderType
    Controls["SelectSwitchType"].String  = DecoderType[1]

    Controls["SelectDecCmdId"].Choices = Decoder_Id_Table
    Controls["SelectDecCmdId"].String  = Decoder_Id_Table[1]

    Controls["SelectDecCmd"].Choices = DecoderCmds
    Controls["SelectDecCmd"].String  = DecoderCmds[1]

    Controls["SelectDecRs232CmdId"].Choices = Decoder_Id_Table
    Controls["SelectDecRs232CmdId"].String  = Decoder_Id_Table[1]

    Controls["SelectDecVidId_1"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecVidId_1"].String  = Encoder_Sw_Id_Table[1]
    Controls["SelectDecVidId_2"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecVidId_2"].String  = Encoder_Sw_Id_Table[1]
    Controls["SelectDecVidId_3"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecVidId_3"].String  = Encoder_Sw_Id_Table[1]
    Controls["SelectDecVidId_4"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecVidId_4"].String  = Encoder_Sw_Id_Table[1]
    Controls["SelectDecVidId_5"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecVidId_5"].String  = Encoder_Sw_Id_Table[1]
    Controls["SelectDecVidId_6"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecVidId_6"].String  = Encoder_Sw_Id_Table[1]
    Controls["SelectDecVidId_7"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecVidId_7"].String  = Encoder_Sw_Id_Table[1]
    Controls["SelectDecVidId_8"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecVidId_8"].String  = Encoder_Sw_Id_Table[1]
    Controls["SelectDecAudId_1"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecAudId_1"].String  = Encoder_Sw_Id_Table[1]
    Controls["SelectDecAudId_2"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecAudId_2"].String  = Encoder_Sw_Id_Table[1]
    Controls["SelectDecAudId_3"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecAudId_3"].String  = Encoder_Sw_Id_Table[1]
    Controls["SelectDecAudId_4"].Choices = Encoder_Sw_Id_Table
    Controls["SelectDecAudId_4"].String  = Encoder_Sw_Id_Table[1]

    for i = 1, Decodersize do
      table.insert(SelectDecVidId, {Dec = "SelectDecVidId_"..tostring(i), Name = "SelectDecVidName_"..tostring(i), Num = i})
    end

    for i = 1, 4 do
      table.insert(SelectDecAudId, {Dec = "SelectDecAudId_"..tostring(i), Name = "SelectDecAudName_"..tostring(i), Num = i})
    end

    --SelectDecAudId_1
  --SelectDecAudName_1


    --Controls.NetControllerConnect.EventHandler = ControllerNetworkConnectEvent

  --  Controls.TxQueTimer.EventHandler           = function() TxQueTimerEvent() end

    Controls.NetControllerConnect.EventHandler = function(ctrl) ControllerNetworkConnectEvent(ctrl, "Connect", nil, nil, nil) end
    Controls.SendPresetCmd.EventHandler        = function(ctrl) ControllerNetworkConnectEvent(ctrl, "SendPresetCmd", nil, "SelectPresetId", nil) end
    Controls.SendApiCmd.EventHandler           = function(ctrl) ControllerNetworkConnectEvent(ctrl, "SendApiCmd", nil, nil, nil) end
    Controls.GetStatus.EventHandler            = function(ctrl) ControllerNetworkConnectEvent(ctrl, "GetStatus", nil, nil, nil) end

    Controls.SendEncCecCmd.EventHandler        = function(ctrl) EncoderControlEvent(ctrl, "Cmds",  "SendEncCecCmd",   "SelectEncCecCmdId", "SelectEncCecCmd")  end
    Controls.SendEncRs232Cmd.EventHandler      = function(ctrl) EncoderControlEvent(ctrl, "RS232", "SendEncRs232Cmd", "SelectEncRs232Id", "SetEncRs232Cmd")  end
    Controls.SetEncAudInputHdmi.EventHandler   = function(ctrl) EncoderControlEvent(ctrl, "Audio", "SetEncAudInputHdmi", "SelectEncAudInputId", nil) end
    Controls.SetAudInputAnalog.EventHandler    = function(ctrl) EncoderControlEvent(ctrl, "Audio", "SetAudInputAnalog",  "SelectEncAudInputId",  nil) end
    
    Controls.SendSwitch.EventHandler           = function(ctrl) DecoderControlEvent(ctrl, "Switch",  "SendSwitch",       "SelectEncSwitchId",   "SelectDecSwitchId",   "SelectSwitchType")  end
    Controls.SendDecCmd.EventHandler           = function(ctrl) DecoderControlEvent(ctrl, "Cmds",    "SendDecCmd",       nil,                   "SelectDecCmdId",      "SelectDecCmd")  end
    Controls.SendDecRs232Cmd.EventHandler      = function(ctrl) DecoderControlEvent(ctrl, "RS232",   "SendDecRs232Cmd",  nil,                   "SelectDecRs232CmdId", "SetDecRs232Cmd")  end

    Controls.SendDecVidWallOn.EventHandler     = function(ctrl) DecoderControlEvent(ctrl, "VidWall", "SendDecVidWallOn",  nil, nil, "VidWallName")  end
    Controls.SendDecVidWallOff.EventHandler    = function(ctrl) DecoderControlEvent(ctrl, "VidWall", "SendDecVidWallOff", nil, nil, "VidWallName")  end

    Controls.SelectEncCecCmdId.EventHandler    = function(ctrl) EncoderControlEvent(ctrl, "Name", "SelectEncCecCmdId",   "EncCecCmdName",   nil) end
    Controls.SelectEncRs232Id.EventHandler     = function(ctrl) EncoderControlEvent(ctrl, "Name", "SelectEncRs232Id",    "EncRs232CmdName", nil) end
    Controls.SelectEncAudInputId.EventHandler  = function(ctrl) EncoderControlEvent(ctrl, "Name", "SelectEncAudInputId", "EncAudInputName", nil) end

    Controls.SelectEncSwitchId.EventHandler    = function(ctrl) DecoderControlEvent(ctrl, "Name", "SelectEncSwitchId",   "EncSwitchName",   Encoder_Name_Table, nil)  end
    Controls.SelectDecCmdId.EventHandler       = function(ctrl) DecoderControlEvent(ctrl, "Name", "SelectDecCmdId",      "DecCmdName",      Decoder_Name_Table, nil)  end
    Controls.SelectDecRs232CmdId.EventHandler  = function(ctrl) DecoderControlEvent(ctrl, "Name", "SelectDecRs232CmdId", "DecRs232CmdName", Decoder_Name_Table, nil)  end

    Controls.SelectDecSwitchId.EventHandler    = function(ctrl) DecoderControlEvent(ctrl, "Show", "SelectDecSwitchId",   "DecSwitchName",   Decoder_Name_Table, "ShowDecRoute")  end
  
    for i = 1, 8 do
      Controls["SelectDecVidId_"..i].EventHandler = function(ctrl) 
        DecoderControlEvent(ctrl, "ShowVid", "SelectDecVidId_"..i, "SelectDecVidName_"..i, Decoder_Name_Table, i)
      end
    end
    Controls.SelectDecAudId_1.EventHandler    = function(ctrl) DecoderControlEvent(ctrl, "ShowAud", "SelectDecAudId_1", "SelectDecAudName_1", Decoder_Name_Table, 1)  end
    Controls.SelectDecAudId_2.EventHandler    = function(ctrl) DecoderControlEvent(ctrl, "ShowAud", "SelectDecAudId_2", "SelectDecAudName_2", Decoder_Name_Table, 2)  end
    Controls.SelectDecAudId_3.EventHandler    = function(ctrl) DecoderControlEvent(ctrl, "ShowAud", "SelectDecAudId_3", "SelectDecAudName_3", Decoder_Name_Table, 3)  end
    Controls.SelectDecAudId_4.EventHandler    = function(ctrl) DecoderControlEvent(ctrl, "ShowAud", "SelectDecAudId_4", "SelectDecAudName_4", Decoder_Name_Table, 4)  end
   
    local PinName = nil

    PinName = "SendApi"
    Controls[PinName].EventHandler = function(ctrl)
      Controls.SetApiCmd.String = ctrl.String
      ControllerNetworkConnectEvent(ctrl, "SendApiCmd", nil, nil, nil)
    end

    for i = 1, Presetsize do
      PinName = "Preset_"..i
      -- Access the input pin by the exact name defined in GetPins
      if Controls[PinName] ~= nil then
        Controls[PinName].EventHandler = function(ctrl)
          Controls["SelectPresetId"].String = tostring(i)
          ControllerNetworkConnectEvent(ctrl, "SendPresetCmd", nil, "SelectPresetId", nil)
        end
      end
    end
      
    for i = 1, Decodersize do
      PinName = "DecoderVid_"..i
      -- Access the input pin by the exact name defined in GetPins
      if Controls[PinName] ~= nil then
        Controls[PinName].EventHandler = function(ctrl)
          if ctrl.String == "0" or ctrl.String == "None" then
            Controls["SelectEncSwitchId"].String = "None"
            Controls["EncSwitchName"].String     = "None"
          else
            if not tonumber(ctrl.String) or tonumber(ctrl.String) > Encodersize then
              print ("Invalid encoder ID: "..ctrl.String)
              return
            end 
            Controls["SelectEncSwitchId"].String = ctrl.String
            Controls["EncSwitchName"].String     = Encoder_Name_Table[tonumber(ctrl.String)]
          end
          Controls["SelectDecSwitchId"].String = tostring(i)
          Controls["SelectSwitchType"].String  = Decoder_Type_Table[DEC_TYPE_VID].Name
          Controls["DecSwitchName"].String     = Decoder_Name_Table[i]
          DecoderControlEvent(ctrl, "Switch", "SendSwitch", "SelectEncSwitchId", "SelectDecSwitchId", "SelectSwitchType")
        end
      end
    end

    for i = 1, Decodersize do
      PinName = "DecoderAud_"..i
      -- Access the input pin by the exact name defined in GetPins
      if Controls[PinName] ~= nil then
        Controls[PinName].EventHandler = function(ctrl)
          if ctrl.String == "0" or ctrl.String == "None" then
            Controls["SelectEncSwitchId"].String = "None"
            Controls["EncSwitchName"].String     = "None"
          else
            if not tonumber(ctrl.String) or tonumber(ctrl.String) > Encodersize then
              print ("Invalid encoder ID: "..ctrl.String)
              return
            end
            Controls["SelectEncSwitchId"].String = ctrl.String
            Controls["EncSwitchName"].String     = Encoder_Name_Table[i]
          end
          Controls["SelectEncSwitchId"].String = ctrl.String
          Controls["SelectDecSwitchId"].String = tostring(i)
          Controls["SelectSwitchType"].String  = Decoder_Type_Table[DEC_TYPE_AUD].Name
          Controls["DecSwitchName"].String     = Decoder_Name_Table[i]
          DecoderControlEvent(ctrl, "Switch", "SendSwitch", "SelectEncSwitchId", "SelectDecSwitchId", "SelectSwitchType")
        end
      end
    end

    for i = 1, Decodersize do
      PinName = "DecoderCmd_"..i
      -- Access the input pin by the exact name defined in GetPins
      if Controls[PinName] ~= nil then
        Controls[PinName].EventHandler = function(ctrl)
          if FindInTable(Controls["SelectDecCmd"].Choices, ctrl.String) then
            Controls["SelectDecCmd"].String   = ctrl.String
            Controls["SelectDecCmdId"].String = tostring(i)
            Controls["DecCmdName"].String    = Decoder_Name_Table[i]
            DecoderControlEvent(ctrl, "Cmds", "SendDecCmd", nil, "SelectDecCmdId", "SelectDecCmd")
          else
            print("Choice not found: "..ctrl.String)
          end
        end
      end
    end

    for i = 1, Encodersize do
      PinName = "EncoderCecCmd_"..i
      -- Access the input pin by the exact name defined in GetPins
      if Controls[PinName] ~= nil then
        Controls[PinName].EventHandler = function(ctrl)
          if FindInTable(Controls["SelectEncCecCmd"].Choices, ctrl.String) then
            Controls["SelectEncCecCmd"].String = ctrl.String
            Controls["SelectEncCecCmdId"].String = tostring(i)
            Controls["EncCecCmdName"].String     = Encoder_Name_Table[i]
            EncoderControlEvent(ctrl, "Cmds", "SendEncCecCmd", "SelectEncCecCmdId", "SelectEncCecCmd")
          else
            print("Choice not found: "..ctrl.String)
          end
        end
      end
    end


  end --initControls()

