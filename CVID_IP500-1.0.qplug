---------------------------------------------------get page--------------------------------------------------
function GetPages(props)
  return
  {
    { name = "Controller"},
    { name = "Encoder"   },
    { name = "Decoder"   },
    { name = "AV Names"  }
    --{ name = "Routing"   }
  }
end

---------------------------------------------------get Pins---------------------------------------------
--[[
function GetPins(props)
  local pins = {}
  
  local Presetsize  = props["Preset_Size"].Value
  Presetsize = tonumber(Presetsize) or 10
  local Decodersize = props["Decoder_Size"].Value
  Decodersize = tonumber(Decodersize) or 8
  
  for i = 1, Presetsize do
    table.insert(pins, {
      Name = "Preset_"..tostring(i),
      Direction = "input"
      Type = "control"
    })
  end
  for i = 1, Decodersize do
    table.insert(pins, {
      Name = "DecoderVid_"..tostring(i),
      Direction = "input"
      Type = "control"
    })
  end
  for i = 1, Decodersize do
    table.insert(pins, {
      Name = "DecoderAud_"..tostring(i),
      Direction = "input"
      Type = "control"
    })
  end
  
  return pins
end
]]

---------------------------------------------------get Components---------------------------------------------
function GetComponents(props)  
  return {}
end


--------------------------------------------------------------------------
--
--------------------------------------------------------------------------
function norm_spaces_lower(s)
  s = s:gsub("\r\n", " ")           --  CRLF 
  s = s:gsub("[%z\1-\31]", " ")     -- 0x00-0x1F
  s = s:gsub("\194\160", " ")       -- UTF-8 NBSP (0xC2 0xA0)
  s = s:gsub("%s+", " ")            -- 
  s = s:gsub("^%s+", ""):gsub("%s+$", "")
  s = s:lower()                     -- 
  return s
end

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
-- Define the Queue class
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
Que = {}

function Que:New()
  local list = { first = 1, last = 0 }
  self.__index = self
  return setmetatable(list, self)
end

-- Check if queue is empty
function Que:Size()
  return self.last - self.first + 1
end

function Que:Clear()
  self.first = 1
  self.last = 0
end

-- Add an item to the end of the queue
function Que:Push(val)

  --print("Push:"..val)

--  if NET.Connected == 1 then
    self.last = self.last + 1
    self[self.last] = val
    if not TxQueTimer:IsRunning() then
      TxQueTimer:Start(.1) -- In seconds .1 = 100ms
    end
  --end
end

-- Remove and return the item from the front of the queue
function Que:Pop()
  if self.first > self.last then
    return nil -- Safely handles an empty queue
  end
  local value = self[self.first]
  self[self.first] = nil
  self.first = self.first + 1
--  print("Pop: "..value)
  return value
end

TxQue = Que:New()

