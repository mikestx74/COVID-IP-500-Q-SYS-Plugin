---------------------------------------------------Properties---------------------------------------------------
function GetProperties()
  local props = {
    {
      Name    = "Connection",
      Type    = "enum",
      Choices = {"TCP","RS232"},
      Value   = "TCP"
    },
    {
      Name = "IP",
      Type = "string",
      Value = "192.168.10.173"
    },
    {
      Name = "TcpPort",
      Type = "string",
      Value = "4001",
      Min  = "1",
      Max  = "65535"
    },
    {
      Name = "SerialName",
      Type = "string",
      Value = "SerialPortName"
    },
    {
      Name = "baudrate",
      Type = "enum",
      Choices = {"115200", "57600", "5600", "38400", "19200","14400","9600","4800","2400"},
      Value = "9600"
    },
    {
      Name = "datalen",
      Type = "enum",
      Choices = {"7","8","9"},
      Value = "8"
    },   
    {
      Name = "stopbit",
      Type = "enum",
      Choices = {"1", "2"},
      Value = "1"
    },
    {
      Name = "paritybit",
      Type = "enum",
      Choices = {"N", "E","O"},
      Value = "N"
    },
    {
      Name = "Preset_Size",
      Type = "string",
      Value = "4",
      Min  = "1",
      Max  = "100"
    },    
    {
      Name = "Encoder_Size",
      Type = "string",
      Value = "2",
      Min  = "1",
      Max  = "100"
    },    
    {
      Name = "Decoder_Size",
      Type = "string",
      Value = "2",
      Min  = "1",
      Max  = "100"
    }
  }
  return props
end

---------------------------------------------------Rectify Properties----------------------------------------
function RectifyProperties(props)

  local Propert = props["Connection"].Value
    
  props["IP"].IsHidden             = true
  props["TcpPort"].IsHidden        = true
  props["SerialName"].IsHidden     = true
  props["baudrate"].IsHidden       = true
  props["datalen"].IsHidden        = true
  props["stopbit"].IsHidden        = true
  props["paritybit"].IsHidden      = true

  if Propert == "TCP" then
    props["IP"].IsHidden          = false 
    props["TcpPort"].IsHidden     = false
  elseif Propert == "RS232" then
    props["SerialName"].IsHidden  =  false
    props["baudrate"].IsHidden    =  false
    props["datalen"].IsHidden     =  false
    props["stopbit"].IsHidden     =  false
    props["paritybit"].IsHidden   =  false
  end
  return props
end

---------------------------------------------------Plugin block Name---------------------------------------
function GetPrettyName(props)
--      return PluginInfo["Name"] .. " v" .. PluginInfo["Version"]
  return PluginInfo.Name.."_"..PluginInfo.Version
end

