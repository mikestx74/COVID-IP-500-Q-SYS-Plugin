      ControlType = "Text",   
      PinStyle = "Input",
      UserPin = true
    })
  end
 
	return ctrls  
end
--------------------------------------------------Control Layout------------------------------------------------
--"GetControls"
function GetControlLayout(props)
  local layout   = {}
  local graphics = {} 
  local offset1  = 20
  local offset2  = 40
  local offset3  = 60
  local offset4  = 80

  -- Setup Pins

  layout["SendApi"] = {
    Style = "None",
    PrettyName = "API Direct"
  }

  local Presetsize  = props["Preset_Size"].Value
  Presetsize = tonumber(Presetsize) or 10
  for i = 1, Presetsize do
    layout["Preset_" .. i] = {
      Style = "None",
      PrettyName = "Preset Btns~".. i
    }
  end

  local Decodersize = props["Decoder_Size"].Value
  Decodersize = tonumber(Decodersize) or 8
  for i = 1, Decodersize do
    layout["DecoderVid_" .. i] = {
      Style = "None",
      PrettyName = "Video Decoders~".. i
    }
  end

  for i = 1, Decodersize do
    layout["DecoderAud_" .. i] = {
      Style = "None",
      PrettyName = "Audio Decoders~".. i
    }
  end

  for i = 1, Decodersize do
    layout["DecoderCmd_" .. i] = {
      Style = "None",
      PrettyName = "Cmd Decoders~".. i
    }
  end

  local Encodersize = props["Encoder_Size"].Value
  Encodersize = tonumber(Encodersize) or 8
  for i = 1, Encodersize do
    layout["EncoderCecCmd_" .. i] = {
      Style = "None",
      PrettyName = "CEC Cmd Encoders~".. i
    }
  end

  -----------------------------------------------------------------------------------------------------
  --Main PAGE Component
  -----------------------------------------------------------------------------------------------------		
  if props['page_index'].Value == 1 then	
