serialName = nil

function SendData_ToDevices(sendData)
  local CommMode = Properties["Connection"].Value
    print("CommMode "..CommMode.." sendData:"..sendData)
  
  --TCP  
  if CommMode == "TCP" and Controls.NetControllerConnect.Value == 1 then 
   	NET.TcpClient:Write(">"..sendData.."\r") 
    print("TCP Send cmd: >"..sendData)
   
  -- RS232
  elseif CommMode == "RS232" then  
		serialNume:Write(">"..sendData.."\r") 
    print("Serial Send cmd: >"..sendData)
  end
end

