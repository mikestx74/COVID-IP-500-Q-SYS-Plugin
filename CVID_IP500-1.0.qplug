--ShowVidRoute
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function ShowVidRoute (Index, DecName, Dec)
  local EncVid = tonumber(Decoder_Status_Table[Index].TypeVid)
  local EncVidName

  --print ("ShowVidRoute Index: "..tostring(Index).." Dec: "..tostring(Dec)) 
