  ---------
  --Q-SYS
  ---------
  --https://help.qsys.com/DeveloperHelp/#Code_Examples/TCPSocket_Example.htm
-- https://help.qsys.com/Content/Control_Scripting/Using_Lua_in_Q-Sys/Timer.htm

--[[
Control Properties

    .Value: Gets or sets the raw numeric value of the control.
    .Position: Gets or sets the normalized position (typically 0.0 to 1.0) of a fader, knob, or button.
    .Boolean: Gets or sets the true/false state of toggle and trigger buttons.
    .String: Returns the text representation of the control state.
    .Index: Returns the numeric index of the control within an array or table.
]]

  --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

  
  local canInitialize = true

  -- Check Properties and other stuff for illegal values

  if canInitialize then
    print("Initializing")
    initControls()
    print("Initialization Complete")
  else
    print("Not initializing")
  end
  -- Nothing should be done after this point

end	--if Controls 
