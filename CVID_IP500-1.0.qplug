Encoder_Name_Table = {}
Decoder_Name_Table = {}
Decoder_Status_Table = {}

--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
--ShowRoute
--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
function ShowRoute (Index, DecType)
  local EncVid = tonumber(Decoder_Status_Table[Index].TypeVid) -- String
  local EncAud = tonumber(Decoder_Status_Table[Index].TypeAud)
  local EncRs  = tonumber(Decoder_Status_Table[Index].TypeRS232)
  local EncIr  = tonumber(Decoder_Status_Table[Index].TypeIR)
  local EncUsb = tonumber(Decoder_Status_Table[Index].TypeUsb)
  local EncCec = tonumber(Decoder_Status_Table[Index].TypeCec)
  local EncVidName
  local EncAudName
  local EncRsName
  local EncIrName
  local EncUsbName
  local EncCecName

--  print ("ShowRoute Index: "..tostring(Index)) 

  --print("EncVid: "..EncVid.." EncAud: "..EncAud)

    if EncVid == 0 then
    EncVidName = "None"
  else
    EncVidName = Encoder_Name_Table[EncVid]
  end
  if EncAud == 0 then
    EncAudName = "None"
  else
    EncAudName = Encoder_Name_Table[EncAud]
  end
  if EncRs == 0 then
    EncRsName = "None"
  else
    EncRsName = Encoder_Name_Table[EncRs]
  end
  if EncIr == 0 then
    EncIrName = "None"
  else
    EncIrName = Encoder_Name_Table[EncIr]
  end
  if EncUsb == 0 then
    EncUsbName = "None"
  else
    EncUsbName = Encoder_Name_Table[EncUsb]
  end
  if EncCec == 0 then
    EncCecName = "None"
  else
    EncCecName = Encoder_Name_Table[EncCec]
  end
    Controls[DecType].String = "Vid: "..EncVidName.." | Aud: "..EncAudName.." | RS: "..EncRsName.."\r"..
                               "IR: "..EncIrName.." | USB: "..EncUsbName.." | CEC: "..EncCecName
end

